{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "1.0",
  "description": "A Chrome extension to export AI chat conversations.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://gemini.google.com/*",
        "*://grok.x.ai/*",
        "*://claude.ai/*"
      ],
      "js": ["content_script.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
